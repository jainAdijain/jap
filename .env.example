# Copy to .env (make start does this for you the first time) and fill in the blanks.
# .env is gitignored. Never commit real keys or passwords.

# Postgres in the db container
POSTGRES_USER=jap
POSTGRES_PASSWORD=jap
POSTGRES_DB=jap
DATABASE_URL=postgresql+psycopg://jap:jap@db:5432/jap

# OpenRouter: every chat model call
OPENROUTER_API_KEY=
JAP_MODEL_EXTRACT=openai/gpt-5.6-luna
JAP_MODEL_WRITE=anthropic/claude-sonnet-4.5

# Ollama runs natively on the Mac (outside Docker), embeddings only
JAP_MODEL_EMBED=nomic-embed-text
JAP_EMBED_DIM=768
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Monthly model spend cap in USD (the AI spend card on My profile can change it)
JAP_MONTHLY_COST_CAP_USD=2

# The mailbox JAP sends from (confirmation and alert emails go to the address on My profile).
# GoDaddy Professional Email: smtpout.secureserver.net, 465, SSL, your full address and its password.
# Gmail instead: SMTP_HOST=smtp.gmail.com and an app password (needs 2-Step Verification).
# A local test mailbox would use SMTP_PORT=1025, SMTP_SSL=false.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=

# Where the confirmation email links back to (the job in JAP)
JAP_UI_URL=http://localhost:5173

# Inngest dev server
INNGEST_DEV=1
INNGEST_BASE_URL=http://inngest:8288

# Time zone for the 06:00 run and the daily cap
JAP_TZ=Asia/Kolkata

# Ports on your Mac (127.0.0.1 only). Change one if another project already uses it.
# API and Inngest default to 8001 and 8290 so they don't clash with other apps on 8000 and 8288-8289
# (an Inngest dev server publishes both).
JAP_UI_PORT=5173
JAP_API_PORT=8001
JAP_INNGEST_PORT=8290
JAP_DB_PORT=5432
JAP_ADMINER_PORT=8080
