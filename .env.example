# Copy to .env (make start does this for you the first time) and fill in the blanks.
# .env is gitignored. Never commit real keys or passwords.

# Which environment this is (PRD H3, H4). This file is the local stack; `make env ENV=live`
# writes .env.live from this file plus infra/env/live.env.
JAP_ENV=dev
# The env file compose injects into the containers. Leave it as .env here; .env.live sets
# itself, so the two stacks never read each other's settings.
JAP_ENV_FILE=.env
# Docker Compose project name: keeps each environment's database volume apart.
JAP_PROJECT=jap
# 1 = built UI behind Caddy, self-hosted Inngest, no Adminer (infra/compose.release.yaml).
JAP_RELEASE=0
# false = an application is never submitted to a job site from this environment.
JAP_SUBMIT_ENABLED=true

# Postgres in the db container
POSTGRES_USER=jap
POSTGRES_PASSWORD=jap
POSTGRES_DB=jap
DATABASE_URL=postgresql+psycopg://jap:jap@db:5432/jap

# OpenRouter: every chat model call
OPENROUTER_API_KEY=
JAP_MODEL_EXTRACT=openai/gpt-5.6-luna
JAP_MODEL_WRITE=anthropic/claude-sonnet-4.5

# Ollama runs natively on the Mac (outside Docker), embeddings only
JAP_MODEL_EMBED=nomic-embed-text
JAP_EMBED_DIM=768
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Monthly model spend cap in USD (the AI spend card on My profile can change it)
JAP_MONTHLY_COST_CAP_USD=2
# Who reads job postings for skills, work mode, regions and the rest (PRD 1.25 R1, 1.30 AH1):
# agent = an outside AI harness (JAP_HARNESS below), through make reader-export and
# make reader-import (it also settles possible duplicates);
# api = JAP's own model call with the key above (the fallback, as before 1.25).
# claude and openrouter, the names before 1.30, still mean agent and api.
JAP_READER=agent
# Who drafts free-text answers on application forms, required cover letters and new resume
# reads (PRD 1.27 W10, 1.30 AH1): agent = the outside AI writer, through make writer-export
# and make writer-import (such a question waits for it at Needs you); api = JAP's own calls.
JAP_WRITER=agent

# The AI harness that does the agent work (PRD 1.30, AH4 to AH7), started by agent/run.sh
# (make agent-run, or the schedule from make ENV=live agent-schedule). One of the adapters in
# agent/harnesses/: claude (Claude Code), codex (OpenAI Codex CLI), gemini (Gemini CLI),
# opencode, devin (Devin's command line tool, PRD 1.33). Try a new one with
# make agent-check HARNESS=<name> before switching here.
JAP_HARNESS=claude
# The model for that harness; empty = the harness's own default.
JAP_HARNESS_MODEL=
# The second pass that checks the writer's answers before they go back (W8): empty = the same
# harness and model; another adapter's name to check with a different model; none = no check.
JAP_CHECKER_HARNESS=
JAP_CHECKER_MODEL=
# Reader shards run in parallel, postings per batch, and minutes one session may take.
JAP_AGENT_SHARDS=8
JAP_AGENT_BATCH=10
JAP_AGENT_TIMEOUT_MIN=20
# The trace of each run (PRD 1.33, O17): empty or 1 = ask the harness for a record of its
# session, so the run log and data*/agent/traces/ hold each model request and tool call with
# its time and tokens (numbers only, never text); 0 = run the harness as before 1.33, and
# the runner still times each session and names the cause of a failure.
JAP_AGENT_TRACE=
# Seconds JAP may take over a run's trace when the runner hands it over to be sent to the
# trace service (PRD 1.34, O22). After that the runner keeps the trace, marked .unsent beside
# its file, and hands it over again at the start of the next run. Empty = 60.
JAP_AGENT_SEND_S=
# Runs that finish (PRD 1.35, AH4): seconds one call to JAP (status, export, import) may take
# before it is stopped, and how many tries a call that did not reach JAP gets (ssh to the VM
# or Docker failed, or the time limit), this many seconds apart. A call JAP answered, even
# with an error, is not tried again. Empty = 120, 3 and 30.
JAP_AGENT_CALL_S=
JAP_AGENT_CALL_TRIES=
JAP_AGENT_RETRY_S=
# Where Devin's command line tool is, when JAP_HARNESS=devin and `devin` is not on PATH.
# Empty = `devin`, else the copy inside Devin Desktop on a Mac.
JAP_DEVIN_BIN=
# When the Mac's schedule runs the reader and the writer each day (HH:MM, the Mac's time).
# After changing these, run make ENV=live agent-schedule again.
JAP_AGENT_READER_AT=07:05
JAP_AGENT_WRITER_AT=07:30

# Pacing applications (A1, V3 to V7, PRD 1.29). Seconds between any two submits, plus up to
# JITTER more (different for each job); at most PER_COMPANY_DAY attempts a day at one company;
# at most PER_ATS_DAY submits a day on one ATS (Greenhouse, Lever, Ashby), ATS_GAP seconds
# apart; and how many jobs past the daily cap an Automatic run picks, so held jobs don't
# leave the day short. A 429 or 403 from an ATS also puts it on hold for 1, 4, then 24 hours.
JAP_APPLY_GAP_SECONDS=30
JAP_APPLY_JITTER_SECONDS=30
JAP_PER_COMPANY_DAY=2
JAP_PER_ATS_DAY=8
JAP_ATS_GAP_SECONDS=300
JAP_AUTO_EXTRA_PICKS=5

# The mailbox JAP sends from (confirmation and alert emails go to the address on My profile).
# GoDaddy Professional Email: smtpout.secureserver.net, 465, SSL, your full address and its password.
# Gmail instead: SMTP_HOST=smtp.gmail.com and an app password (needs 2-Step Verification).
# A local test mailbox would use SMTP_PORT=1025, SMTP_SSL=false.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
# The same mailbox read over IMAP for a security code Greenhouse emails (PRD A5). A Gmail
# filter forwards those emails here. Gmail instead: IMAP_HOST=imap.gmail.com.
IMAP_HOST=imap.secureserver.net
IMAP_PORT=993
IMAP_SSL=true

# Where JAP's emails link back to: the job in JAP, and password reset links
JAP_UI_URL=http://localhost:5173

# Sign-in (PRD S1 to S5). JAP_COOKIE_SECURE=true wherever JAP is served over HTTPS.
# JAP_ADMIN_EMAIL, when set, is the only address that can create the first (admin) account.
JAP_COOKIE_SECURE=false
JAP_ADMIN_EMAIL=
JAP_SESSION_IDLE_DAYS=7
JAP_SESSION_MAX_DAYS=30

# Inngest: the dev server here; test and prod run a self-hosted server with their own keys
# (make env-create generates both).
INNGEST_DEV=1
INNGEST_BASE_URL=http://inngest:8288
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Logging, Status and alerts (PRD 1.19). JAP_ENV names this environment on log lines,
# alert subjects and Sentry. LOG_JSON=false prints plain lines instead of JSON.
JAP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true
# Health alert emails (Daily search missed, stuck search, error bursts, AI spend, disk).
JAP_ALERTS_ENABLED=true
JAP_ALERT_ERRORS_PER_HOUR=10
# Sentry's free Developer plan: paste the project's DSN to send redacted errors. Empty = off.
SENTRY_DSN=
# The trace service for AI work (PRD 1.33, O22, O23): empty = off, and both must be set.
# Only numbers, ids and names from fixed lists are sent, never text. The endpoint is the
# service's OpenTelemetry address (LangSmith: https://api.smith.langchain.com/otel, or
# https://eu.api.smith.langchain.com/otel for the EU region); /v1/traces is added when it is
# not already there. The headers are
# name=value,name=value and hold the service's key (LangSmith: x-api-key=<key> with either
# Langsmith-Project=jap, or Langsmith-Agent-Id=<id> and Langsmith-Agent-Environment=production).
# The key is never given to a harness.
JAP_TRACE_ENDPOINT=
JAP_TRACE_HEADERS=

# Time zone for the 06:00 run and the daily cap
JAP_TZ=Asia/Kolkata

# Ports on your Mac (127.0.0.1 only). Change one if another project already uses it.
# API and Inngest default to 8001 and 8290 so they don't clash with other apps on 8000 and 8288-8289
# (an Inngest dev server publishes both).
JAP_UI_PORT=5173
JAP_API_PORT=8001
JAP_INNGEST_PORT=8290
JAP_DB_PORT=5432
JAP_ADMINER_PORT=8080
