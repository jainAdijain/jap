# prod (PRD H3, H4): make env-create ENV=prod copies .env.example and replaces these keys.
# The only environment that submits applications and sends email: fill in the real mailbox.
JAP_ENV=prod
JAP_PROJECT=jap-prod
JAP_RELEASE=1
JAP_SUBMIT_ENABLED=true
# Sign-in (PRD S5): session cookies only over HTTPS.
JAP_COOKIE_SECURE=true
JAP_UI_URL=https://jap.tutorial.monster
JAP_MONTHLY_COST_CAP_USD=2
INNGEST_DEV=0
JAP_UI_PORT=5373
JAP_API_PORT=8201
JAP_INNGEST_PORT=8490
JAP_DB_PORT=5434
JAP_ADMINER_PORT=8280
