# live (PRD H3, H4): the settings that differ from .env.example.
# infra/scripts/env-create.sh copies .env.example and replaces every key below, then adds a
# fresh database password and Inngest keys, and writes the result to .env.live.
#
# This is the only environment on the internet, and the only one that submits applications
# and sends email. Everything it owns is separate from local: its own Docker project, its own
# database volume, its own data folder and its own ports.

# JAP_ENV drives the UI badge: anything but prod shows one (App.tsx), so live has no badge.
JAP_ENV=prod
JAP_PROJECT=jap-live
# The file compose injects into the containers (infra/compose.yaml, env_file).
JAP_ENV_FILE=.env.live
# Adds infra/compose.release.yaml: built UI behind Caddy, no source mounts, no Adminer.
JAP_RELEASE=1
JAP_SUBMIT_ENABLED=true

# Sign-in (PRD S5): the session cookie is Secure and __Host- prefixed only when this is true.
JAP_COOKIE_SECURE=true
# Where reset links and confirmation emails point, and the only origin a write may come from.
JAP_UI_URL=https://jap.tutorial.monster
CORS_ORIGINS=["https://jap.tutorial.monster"]

JAP_MONTHLY_COST_CAP_USD=2
JAP_ALERTS_ENABLED=true
INNGEST_DEV=0

# Real resumes, cover letters, screenshots and backups, kept apart from local's scratch copy.
JAP_DATA_HOST_DIR=data-live

# Ports, all on 127.0.0.1. Only JAP_UI_PORT is reachable through the tunnel (PRD H2).
JAP_UI_PORT=5373
JAP_API_PORT=8201
JAP_INNGEST_PORT=8490
JAP_DB_PORT=5434
JAP_ADMINER_PORT=8280
