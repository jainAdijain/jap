# test (PRD H3, H4): make env-create ENV=test copies .env.example and replaces these keys.
# Prepares applications but never submits one and never sends email (no SMTP login).
JAP_ENV=test
JAP_PROJECT=jap-test
JAP_RELEASE=1
JAP_SUBMIT_ENABLED=false
# Sign-in (PRD S5): session cookies only over HTTPS.
JAP_COOKIE_SECURE=true
JAP_UI_URL=https://test.jap.tutorial.monster
JAP_MONTHLY_COST_CAP_USD=1
SMTP_USERNAME=
SMTP_PASSWORD=
INNGEST_DEV=0
JAP_UI_PORT=5273
JAP_API_PORT=8101
JAP_INNGEST_PORT=8390
JAP_DB_PORT=5433
JAP_ADMINER_PORT=8180
